{
  "name": "@agentwing/sdk",
  "version": "0.1.0",
  "description": "Runtime control layer for AI agents — check every action before it runs.",
  "license": "Apache-2.0",
  "type": "module",
  "sideEffects": false,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/12ziyad/agentwing.git",
    "directory": "packages/sdk"
  },
  "homepage": "https://agentwing.gpmai.dev/docs",
  "bugs": "https://github.com/12ziyad/agentwing/issues",
  "keywords": [
    "ai",
    "agent",
    "agents",
    "guardrails",
    "policy",
    "authorization",
    "approval",
    "sandbox",
    "llm"
  ],
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm run build"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5"
  }
}
